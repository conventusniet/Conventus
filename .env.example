# Copy to .env.local and fill in. Rotate this key — it was previously committed.

# Google Apps Script web-app URL that appends waitlist rows to your Sheet
WAITLIST_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# OpenRouter API key for the Conventus chatbot (free models only — ":free" model ids).
OPENROUTER_API_KEY=your-openrouter-key-here

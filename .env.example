# Copy to .env.local and fill in. Rotate any key that was previously committed.

# OpenRouter API key for the Conventus chatbot (free models only — ":free" model ids).
OPENROUTER_API_KEY=your-openrouter-key-here

# --- CMUN Connect registration (see docs/registration-setup.md) ---
# Google Apps Script web-app URL: sends OTP emails + saves registrations to a Sheet/Drive.
REGISTRATION_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec
# Long random string that signs the email-verification tokens. Generate: openssl rand -hex 32
REGISTRATION_SECRET=change-me-to-a-long-random-string

# --- Admin dashboard (/admin/registrations) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
# Shared secret for privileged reads; paste the SAME value into the Apps Script ADMIN_KEY constant.
ADMIN_KEY=change-me-generate-with-openssl-rand-hex-24
